X_FOLLOW_LIST_ENV=production
X_FOLLOW_LIST_DATA_DIR=/var/lib/x-follow-list
X_FOLLOW_LIST_MASTER_KEY=replace-with-at-least-32-random-characters
X_FOLLOW_LIST_BOOTSTRAP_TOKEN=replace-with-a-one-time-bootstrap-token
X_FOLLOW_LIST_APP_ORIGIN=http://127.0.0.1:8080
X_FOLLOW_LIST_DISPLAY_TIMEZONE=Asia/Taipei
X_FOLLOW_LIST_MIN_FREE_DISK_BYTES=2147483648
X_FOLLOW_LIST_LOG_LEVEL=INFO
