# Runtime mode: development, test, or production.
X_FOLLOW_LIST_ENV=development

# Absolute path to the protected application data directory.
X_FOLLOW_LIST_DATA_DIR=

# Required in production. Supply through a secret manager; never commit a real value.
X_FOLLOW_LIST_MASTER_KEY=

# Optional one-time OWNER bootstrap token. If empty, a protected token file is generated.
X_FOLLOW_LIST_BOOTSTRAP_TOKEN=

# SQLite lock wait in milliseconds. Must be between 100 and 120000.
X_FOLLOW_LIST_SQLITE_BUSY_TIMEOUT_MS=5000

# Minimum free bytes required for API readiness; defaults to 2 GiB.
X_FOLLOW_LIST_MIN_FREE_DISK_BYTES=2147483648

# Login session lifetime and exact browser origin accepted for state-changing requests.
X_FOLLOW_LIST_SESSION_TTL_SECONDS=43200
X_FOLLOW_LIST_APP_ORIGIN=http://127.0.0.1:8000

# IANA timezone used alongside UTC in XLSX exports (for example Asia/Taipei).
X_FOLLOW_LIST_DISPLAY_TIMEZONE=UTC

# DEBUG, INFO, WARNING, ERROR, or CRITICAL.
X_FOLLOW_LIST_LOG_LEVEL=INFO
